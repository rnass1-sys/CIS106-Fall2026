<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="ps1p3"/>
        <attribute name="authors" value="rache"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-03 11:09:49 AM"/>
        <attribute name="created" value="cmFjaGU7UkFOQVNTOzIwMjYtMDktMDM7MTA6NTI6NDMgQU07MjIzNw=="/>
        <attribute name="edited" value="cmFjaGU7UkFOQVNTOzIwMjYtMDktMDM7MTE6MDk6NDkgQU07MTsyMzU0"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="length" type="Real" array="False" size=""/>
            <declare name="width" type="Real" array="False" size=""/>
            <declare name="area" type="Real" array="False" size=""/>
            <declare name="circumference" type="Real" array="False" size=""/>
            <input variable="length"/>
            <input variable="width"/>
            <assign variable="area" expression="width * length"/>
            <assign variable="circumference" expression="2 * length + 2 * width"/>
            <output expression="&quot;Display the area: &quot; &amp; area &amp; &quot; and circumference: &quot; &amp; circumference" newline="True"/>
        </body>
    </function>
</flowgorithm>
