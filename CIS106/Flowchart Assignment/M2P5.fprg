<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="ps1p5"/>
        <attribute name="authors" value="rache"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-03 11:27:23 AM"/>
        <attribute name="created" value="cmFjaGU7UkFOQVNTOzIwMjYtMDktMDM7MTE6MTg6NDYgQU07MjI0Mw=="/>
        <attribute name="edited" value="cmFjaGU7UkFOQVNTOzIwMjYtMDktMDM7MTE6Mjc6MjMgQU07MTsyMzQ2"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="price" type="Real" array="False" size=""/>
            <declare name="discountPercent" type="Real" array="False" size=""/>
            <declare name="discountAmount" type="Real" array="False" size=""/>
            <declare name="discountedPrice" type="Real" array="False" size=""/>
            <input variable="price"/>
            <input variable="discountPercent"/>
            <assign variable="discountAmount" expression="price * discountPercent"/>
            <assign variable="discountedPrice" expression="price - discountAmount"/>
            <output expression="&quot;Discount Amount: $&quot; &amp; discountAmount &amp; &quot; | Final Price: $&quot; &amp; discountedPrice" newline="True"/>
        </body>
    </function>
</flowgorithm>
